digraph SINT {
rankdir=LR; bgcolor="white"; pad=0.3; nodesep=0.5; ranksep=0.7;
node [shape=circle, fontname="Helvetica", fontsize=13, width=0.55, fixedsize=false];
edge [fontname="Helvetica", fontsize=12];

labelloc=b; fontname="Helvetica"; fontsize=12; label="VALOR = ENTERO | CADENA | BOOLEANO\lIDENT, ENTERO, CADENA y BOOLEANO son tokens del analizador léxico.\lLas transiciones no mostradas conducen al estado trampa ⊥.\l";
__ini [shape=point, width=0.08, label=""];
q0 [shape=doublecircle];
q1 [shape=circle];
q2 [shape=circle];
q3 [shape=circle];
q4 [shape=circle];
q5 [shape=circle];
q6 [shape=circle];
q7 [shape=circle];
q8 [shape=circle];
q9 [shape=circle];
q10 [shape=circle];
__ini -> q0;
q0 -> q1 [label="INSERTAR"];
q1 -> q2 [label="EN"];
q2 -> q3 [label="TABLA"];
q3 -> q4 [label="IDENT"];
q4 -> q5 [label="VALORES"];
q5 -> q6 [label="':'"];
q6 -> q7 [label="IDENT"];
q7 -> q8 [label="'='"];
q8 -> q9 [label="VALOR"];
q9 -> q6 [label="','"];
q9 -> q10 [label="FIN"];
q10 -> q0 [label="';'"];
}