digraph AFD {
rankdir=LR; bgcolor="white"; pad=0.3; nodesep=0.5; ranksep=0.7;
node [shape=circle, fontname="Helvetica", fontsize=13, width=0.55, fixedsize=false];
edge [fontname="Helvetica", fontsize=12];

labelloc=b; fontname="Helvetica"; fontsize=12; label="L = [A-Za-z_]  letra o guion bajo\lD = [0-9]  dígito\lLas transiciones no mostradas conducen al estado trampa ⊥.\l";
__ini [shape=point, width=0.08, label=""];
q0 [shape=circle];
q1 [shape=doublecircle];
__ini -> q0;
q0 -> q1 [label="L"];
q1 -> q1 [label="L, D"];
}