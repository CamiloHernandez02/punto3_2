digraph AFD {
rankdir=LR; bgcolor="white"; pad=0.3; nodesep=0.5; ranksep=0.7;
node [shape=circle, fontname="Helvetica", fontsize=13, width=0.55, fixedsize=false];
edge [fontname="Helvetica", fontsize=12];

labelloc=b; fontname="Helvetica"; fontsize=12; label="Q = '  comilla simple (apóstrofo)\lC = [^'\\n]  cualquier símbolo salvo ' y salto de línea\lLas transiciones no mostradas conducen al estado trampa ⊥.\l";
__ini [shape=point, width=0.08, label=""];
q0 [shape=circle];
q1 [shape=circle];
q2 [shape=doublecircle];
__ini -> q0;
q0 -> q1 [label="Q"];
q1 -> q1 [label="C"];
q1 -> q2 [label="Q"];
q2 -> q1 [label="Q"];
}